# Dependencies & build output
node_modules/
dist/
# Compiled functions output ONLY — a bare lib/ would swallow frontend/src/lib
functions/lib/
coverage/

# Environment & secrets — never commit
.env
.env.*
!.env.example
# functions/.env holds only non-secret emulator defaults — committed on purpose
!functions/.env
*.local
*serviceAccount*.json
*.pem
*.key
credentials.*
.runtimeconfig.json

# Firebase
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
pglite-debug.log*
emulator-data/

# Editor/OS
.DS_Store
*.log
.playwright-mcp/
