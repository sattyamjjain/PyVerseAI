    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.14",
    "eventsource-parser": "^4.1.0",
    "firebase": "^12.18.0",
    "highlight.js": "^11.12.0",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^15.0.0",
    "monaco-editor": "^0.56.0",
    "pinia": "^4.0.2",
    "reka-ui": "^2.10.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "vue-sonner": "^2.0.9",
    "zod": "^4.4.3"
