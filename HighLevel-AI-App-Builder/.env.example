# ──────────────────────────────────────────────────────────────────────────────
# Genesis — environment reference
# Copy the relevant sections into the real files noted below. Never commit any
# real values; everything secret lives in Firebase Secret Manager or *.local
# files, which are gitignored.
# ──────────────────────────────────────────────────────────────────────────────

# ═══ frontend/.env (Vite; all VITE_* values are PUBLIC by design) ═══
# Firebase web config — public identifiers, not secrets (security lives in
# Firestore rules + Auth + the functions layer).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Base URL of deployed Cloud Functions (SSE + proxy are called at their direct
# URL — Firebase Hosting rewrites cannot stream).
# Prod example: https://us-central1-<project-id>.cloudfunctions.net
# Emulators:    http://127.0.0.1:5001/demo-genesis/us-central1
VITE_FUNCTIONS_BASE=
# Set to "true" to connect the app to local Firebase emulators.
VITE_USE_EMULATORS=true

# ═══ functions/.env (non-secret function config, committed values OK) ═══
# HighLevel marketplace app — Client ID is public-ish; the SECRET is not (see below).
HL_CLIENT_ID=
# The deployed hlAuthCallback URL, registered verbatim as a Redirect URL in the
# HighLevel marketplace app settings.
HL_REDIRECT_URI=
# Comma-separated origins allowed for CORS + OAuth return redirects.
# Example: https://<project-id>.web.app,https://<project-id>.firebaseapp.com,http://localhost:5173
APP_ORIGINS=
# Set to "true" ONLY for local emulator development without a HighLevel account:
# the OAuth flow + HL API calls are served by a built-in mock instead.
HL_MOCK_MODE=false

# ═══ Firebase Secret Manager (functions/.secret.local for emulators) ═══
# Set in prod with:  firebase functions:secrets:set ANTHROPIC_API_KEY
#                    firebase functions:secrets:set HL_CLIENT_SECRET
# For emulators, put KEY=value lines in functions/.secret.local (gitignored).
ANTHROPIC_API_KEY=
HL_CLIENT_SECRET=
