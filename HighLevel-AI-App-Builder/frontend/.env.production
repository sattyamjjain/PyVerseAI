# Production build config for genesis-hl-builder-sj.
# The Firebase web config is PUBLIC BY DESIGN (it identifies the project and
# grants nothing) — committed so a fresh clone deploys with three commands.
VITE_FIREBASE_API_KEY=AIzaSyCsya4Zttr4tYYl7dX-G7b4zT_dAKMDX_4
VITE_FIREBASE_AUTH_DOMAIN=genesis-hl-builder-sj.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=genesis-hl-builder-sj
VITE_FIREBASE_APP_ID=1:7358115240:web:363ec097dd73d68e26019d
# Cloud Functions are called at their DIRECT URL (Hosting rewrites can't stream SSE).
VITE_FUNCTIONS_BASE=https://us-central1-genesis-hl-builder-sj.cloudfunctions.net
VITE_USE_EMULATORS=false
