# Non-secret function config. Committed values are emulator-safe defaults;
# production values are set before deploy (see README → Deployment).
HL_CLIENT_ID=
# Emulator callback URL (mock mode). Prod: the deployed hlAuthCallback URL.
HL_REDIRECT_URI=http://127.0.0.1:5001/demo-genesis/us-central1/hlAuthCallback
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Mock HighLevel for local development without a developer account.
HL_MOCK_MODE=true
# Base64-encoded PEM public key for webhook signature verification (prod).
HL_WEBHOOK_PUBKEY_B64=
